{
  "name": "obsidian-true-outliner",
  "version": "0.8.0",
  "description": "A true outliner for Obsidian — mapping core library",
  "main": "src/index.ts",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "dev": "node esbuild.config.mjs",
    "build:plugin": "node esbuild.config.mjs production",
    "vault:install": "node esbuild.config.mjs production --dev",
    "vault:reset": "git checkout -- test-vault",
    "obsidian:fetch": "node scripts/obsidian-fetch.mjs",
    "test:e2e": "node scripts/run-e2e.mjs desktop",
    "test:e2e:mobile": "node scripts/run-e2e.mjs mobile",
    "test:e2e:narrow": "node scripts/e2e-narrow.mjs",
    "test:e2e:docker": "node scripts/e2e-docker.mjs desktop",
    "test:e2e:docker:mobile": "node scripts/e2e-docker.mjs mobile",
    "build:e2e": "tsc --noEmit -p e2e && tsc --noEmit -p website/capture",
    "docs:capture": "node scripts/capture-media.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "docs:dev": "vitepress dev website",
    "docs:build": "vitepress build website",
    "docs:preview": "vitepress preview website"
  },
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.38.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@wdio/cli": "^9.29.1",
    "@wdio/globals": "^9.29.1",
    "@wdio/json-reporter": "^9.31.2",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "builtin-modules": "^5.3.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "fast-check": "^4.9.0",
    "mocha": "^11.7.6",
    "obsidian": "^1.13.1",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.2.2",
    "vitepress": "^2.0.0-alpha.20",
    "vitest": "^5.0.0",
    "vue": "^3.5.42",
    "wdio-obsidian-reporter": "^3.1.1",
    "wdio-obsidian-service": "^3.1.1",
    "webdriverio": "^9.29.1"
  }
}
