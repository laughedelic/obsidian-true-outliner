{
  "name": "obsidian-true-outliner",
  "version": "0.13.6",
  "description": "A true outliner for Obsidian — mapping core library",
  "main": "src/index.ts",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "node scripts/build.ts production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests && node scripts/check-research-index.ts && node scripts/sync-labels.ts --check",
    "dev": "node scripts/build.ts",
    "vault:install": "node scripts/build.ts production --dev",
    "vault:reset": "git checkout -- test-vault",
    "obsidian:fetch": "node scripts/obsidian-fetch.ts",
    "test:e2e": "node scripts/run-e2e.ts desktop",
    "test:e2e:mobile": "node scripts/run-e2e.ts mobile",
    "test:e2e:narrow": "node scripts/e2e-narrow.ts",
    "test:e2e:docker": "node scripts/e2e-docker.ts desktop",
    "test:e2e:docker:mobile": "node scripts/e2e-docker.ts mobile",
    "typecheck:e2e": "tsc --noEmit -p e2e-tests",
    "typecheck:scripts": "tsc --noEmit -p scripts",
    "version": "node scripts/version-bump.ts && git add manifest.json versions.json"
  },
  "license": "MPL-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "@wdio/cli": "^9.31.9",
    "@wdio/globals": "^9.31.3",
    "@wdio/json-reporter": "^9.31.2",
    "@wdio/junit-reporter": "^9.32.0",
    "@wdio/local-runner": "^9.31.9",
    "@wdio/mocha-framework": "^9.31.9",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "fast-check": "^4.10.1",
    "mocha": "^12.0.2",
    "obsidian": "^1.13.1",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wdio-obsidian-reporter": "^3.2.1",
    "wdio-obsidian-service": "^3.2.1",
    "webdriverio": "^9.29.1",
    "yaml": "^2.9.1"
  }
}
