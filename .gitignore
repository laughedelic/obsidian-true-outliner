# `.agents/skills/` is the one real copy of the OpenSpec skills, and the per-tool
# directories hold symlinks into it; all three are tracked. Only the generated
# slash-command files are not — `openspec update` rewrites them.
/.claude/commands/
/.github/prompts/

node_modules/
dist/
/main.js
/test-vault/.obsidian/plugins/true-outliner/main.js
/test-vault/.obsidian/plugins/true-outliner/styles.css
# Generated by scripts/stamp-vault-manifest.mjs on every vault:install —
# deliberately differs from the real (tracked) root manifest.json every run.
/test-vault/.obsidian/plugins/true-outliner/manifest.json

# Obsidian UI session state — rewritten on every open, not a fixture
/test-vault/.obsidian/workspace.json
/test-vault/.obsidian/workspace-mobile.json

# Hub-scale backlink fixture — several hundred generated notes whose only property is
# bulk. Reproduce with `node scripts/gen-backlink-hub.mjs`; see docs/research/19.
/test-vault/Backlinks/Hub/

# e2e harness
.obsidian-cache/

# Design canvases: working artboards and the seeded page, kept out of the repo.
# The published canvas is the artifact; these are its source and are regenerated
# from `gen.py` whenever a round changes.
design/
